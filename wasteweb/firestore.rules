rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSuperAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    function isAdminOrAbove() {
      return isAdmin() || isSuperAdmin();
    }

    function isOperator() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'operator';
    }

    function isContractor() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'contractor';
    }

    function isContractorAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'contractorAdmin';
    }

    function isOperatorAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'operatorAdmin';
    }

    function isKycApproved(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.kycStatus == 'approved';
    }

    function hasKycStarted(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.kycStatus
             in ['pending', 'submitted', 'approved'];
    }

    match /users/{userId} {
      allow create: if isSignedIn()
                    && isOwner(userId)
                    && request.resource.data.keys().hasAll(['uid', 'fullName', 'email', 'role', 'kycStatus'])
                    && request.resource.data.role in ['contractorAdmin', 'operatorAdmin']
                    && request.resource.data.kycStatus == 'pending'
                    && request.resource.data.uid == request.auth.uid;

      allow read: if isSignedIn()
                  && (
                    isOwner(userId)
                    || isAdminOrAbove()
                    || isOperator()
                    || isContractor()
                    || isContractorAdmin()
                    || isOperatorAdmin()
                  );

      allow update: if isSignedIn()
                    && isOwner(userId)
                    && !('role' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('uid'  in request.resource.data.diff(resource.data).affectedKeys())
                    && (
                      !('kycStatus' in request.resource.data.diff(resource.data).affectedKeys())
                      || (resource.data.kycStatus == 'pending' && request.resource.data.kycStatus == 'submitted')
                    );

      allow update: if isAdminOrAbove();

      allow delete: if false;

      match /priceList/{sizeKey} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId) && isOperatorAdmin();
      }

      match /private/{docId} {
        allow read: if isSignedIn()
                    && (
                      isOwner(userId)
                      || isAdminOrAbove()
                      || (isOperatorAdmin() && get(/databases/$(database)/documents/users/$(userId)).data.operatorAdminId == request.auth.uid)
                      || (isContractorAdmin() && get(/databases/$(database)/documents/users/$(userId)).data.contractorAdminId == request.auth.uid)
                    );
        allow write: if false;
      }
    }

    match /kyc/{userId} {
      allow create: if isSignedIn()
                    && isOwner(userId)
                    && !exists(/databases/$(database)/documents/kyc/$(userId));

      allow read: if isSignedIn()
                  && (isOwner(userId) || isAdminOrAbove());

      allow update: if false;
      allow delete: if false;
    }

    match /wasteRequests/{requestId} {

      allow create: if isSignedIn()
                    && isContractor()
                    && hasKycStarted(request.auth.uid)
                    && request.resource.data.contractorId == request.auth.uid
                    && request.resource.data.status == 'pending';

      allow read: if isSignedIn()
                  && (
                    (isContractor() && resource.data.contractorId == request.auth.uid)
                    || (isOperator() && hasKycStarted(request.auth.uid)
                        && ('assignedOperatorId' in resource.data)
                        && resource.data.assignedOperatorId == request.auth.uid)
                    || isAdminOrAbove()
                    || isContractorAdmin()
                    || isOperatorAdmin()
                  );

      allow update: if isSignedIn()
                    && isContractor()
                    && resource.data.contractorId == request.auth.uid
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'cancelled'
                    && !('contractorId' in request.resource.data.diff(resource.data).affectedKeys());

      allow update: if isSignedIn()
                    && isContractor()
                    && resource.data.contractorId == request.auth.uid
                    && resource.data.status == 'scheduled'
                    && request.resource.data.awaitingUserConfirmation == false
                    && request.resource.data.status == 'confirmed'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['awaitingUserConfirmation', 'userConfirmedAt', 'updatedAt', 'status']);

      allow update: if isSignedIn()
                    && isContractor()
                    && resource.data.contractorId == request.auth.uid
                    && resource.data.status == 'scheduled'
                    && request.resource.data.rescheduleRequest != null
                    && request.resource.data.status == 'awaiting_reschedule'
                    && !('contractorId' in request.resource.data.diff(resource.data).affectedKeys());

      // Two-way confirmation gate: the operator cannot move a request to
      // 'arriving' until the contractor has confirmed it ('confirmed'),
      // and cannot move it to 'in_transit' without having passed through
      // 'arriving' first. This mirrors the client-side ALLOWED_TRANSITIONS
      // in app/operators/requests/page.tsx so it can't be bypassed by
      // calling Firestore directly.
      allow update: if isSignedIn()
                    && isOperator()
                    && hasKycStarted(request.auth.uid)
                    && ('assignedOperatorId' in resource.data)
                    && resource.data.assignedOperatorId == request.auth.uid
                    && resource.data.status != 'completed'
                    && resource.data.status != 'declined'
                    && resource.data.status != 'cancelled'
                    && !('contractorId' in request.resource.data.diff(resource.data).affectedKeys())
                    && !(request.resource.data.status == 'arriving' && resource.data.status != 'confirmed')
                    && !(request.resource.data.status == 'in_transit' && resource.data.status != 'arriving');

      allow update: if isOperatorAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['region']);

      allow update: if isOperatorAdmin()
                    && resource.data.status == 'pending'
                    && resource.data.targetOperatorAdminId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedOperatorId', 'assignedAt', 'updatedAt']);

      allow update: if isAdminOrAbove()
                    && request.resource.data.status in [
                      'pending', 'scheduled', 'arriving',
                      'in_transit', 'completed', 'declined',
                      'cancelled', 'archived', 'awaiting_reschedule'
                    ];

      allow delete: if false;
    }

    match /notifications/{userId}/items/{notifId} {
      allow create: if false;
      allow read:   if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn()
                    && isOwner(userId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    match /adminLogs/{logId} {
      allow read:   if isAdminOrAbove();
      allow create: if isSignedIn() && request.resource.data.actorId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /platformSettings/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

